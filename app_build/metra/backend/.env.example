# METRA Backend Environment Variables

METRA_ENV=development
METRA_SECRET_KEY=dev-only-change-me
METRA_ALLOWED_ORIGINS=http://localhost:3000

# Clerk Auth Configuration
# Obtain from Clerk Dashboard > API Keys > Advanced
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# E.g. https://<instance-subdomain>.clerk.accounts.dev
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional: explicitly set JWKS URL if different from {CLERK_ISSUER}/.well-known/jwks.json
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# Optional: PEM public key from Clerk Dashboard > API Keys > Advanced > JWT Public Key
CLERK_JWT_KEY=

# Pipeline & Storage
METRA_DATABASE_URL=sqlite:///./metra.db
METRA_UPLOAD_DIR=./uploads
METRA_MAX_UPLOAD_MB=15
METRA_OCR_ENGINE=mock
